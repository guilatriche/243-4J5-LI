[Unit]
Description=Interface IoT Pygame – Projet mi-session (Guillaume-Retier)
After=network-online.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/243-4J5-LI/projet-mi-session/interface
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/admin/243-4J5-LI/projet-mi-session/interface/main.py
Restart=on-failure
RestartSec=5
# Correctif pour RPi 5 sans bureau (KMSDRM)
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_VIDEO_GL_DRIVER=libGLESv2.so
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
